# Ignore everything and selectively allow files
*

!.clusterfuzzlite/*
!.envrc
!.github/**/*
!.gitignore
!.zed/settings.json
!build.rs
!Cargo.lock
!Cargo.toml
!CODEOWNERS
!CODE_OF_CONDUCT.md
!deny.toml
!default.nix
!flake.lock
!flake.nix
!fuzz/Cargo.lock
!fuzz/Cargo.toml
!fuzz/colon_records.dict
!fuzz/fuzz_targets/*.rs
!fuzz/seeds/**/*
!LICENSE
!proptest-regressions/**/*.txt
!README.md
!SECURITY.md
!src/*.rs
!src/snapshots/*
!tests/snapshots/*
!tests/**/*.rs
!tests/testdata/*
!typos.toml

# Recurse through sub-directories applying the same patterns
!*/

target/**/*
