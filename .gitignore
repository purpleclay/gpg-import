# Ignore everything and selectively allow files
*

!.envrc
!.github/**/*
!.gitignore
!.zed/settings.json
!build.rs
!Cargo.lock
!Cargo.toml
!CODEOWNERS
!CODE_OF_CONDUCT.md
!deny.toml
!default.nix
!flake.lock
!flake.nix
!LICENSE
!README.md
!src/*.rs
!src/snapshots/*
!tests/snapshots/*
!tests/**/*.rs
!tests/testdata/*
!typos.toml

# Recurse through sub-directories applying the same patterns
!*/

target/**/*
